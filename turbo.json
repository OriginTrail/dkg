{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DKG_SKIP_EVM_BUILD"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "extension/dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/testing/**"]
    },
    "build:ui": {
      "dependsOn": ["build"],
      "outputs": ["dist-ui/**"]
    },
    "build:full": {
      "dependsOn": ["build", "build:ui"],
      "outputs": ["dist/**", "dist-ui/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/testing/**"]
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.coverage.ts",
        "$TURBO_ROOT$/scripts/lib/coverage-scope.mjs",
        "$TURBO_ROOT$/scripts/ci/check-coverage.mjs",
        "$TURBO_ROOT$/test-policy/coverage-baselines.json",
        "$TURBO_ROOT$/scripts/testing/**"
      ],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "lint": {},
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
