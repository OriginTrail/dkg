{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DKG_SKIP_EVM_BUILD"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "extension/dist/**"
      ]
    },
    "@origintrail-official/dkg-semantic-runtime#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/rust/**",
        "!$TURBO_ROOT$/rust/target/**",
        "$TURBO_ROOT$/scripts/build-semantic-runtime.mjs",
        "$TURBO_ROOT$/scripts/semantic-runtime-rustc.mjs"
      ],
      "outputs": ["dist/**", "generated/**"]
    },
    "build:ui": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "dist-ui/**"
      ]
    },
    "build:full": {
      "dependsOn": [
        "build",
        "build:ui"
      ],
      "outputs": [
        "dist/**",
        "dist-ui/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.coverage.ts",
        "$TURBO_ROOT$/scripts/lib/coverage-scope.mjs",
        "$TURBO_ROOT$/scripts/ci/check-coverage.mjs",
        "$TURBO_ROOT$/test-policy/coverage-baselines.json"
      ],
      "outputs": [
        "coverage/**"
      ],
      "cache": false
    },
    "lint": {},
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
