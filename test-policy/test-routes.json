    "command": "cd tools/observability/w1 && promtool test rules w1-rules.test.yaml",
    "layer": "monitoring rules",
    "prerequisites": [
      "Prometheus promtool"
    ]
  },
  {
    "pattern": "scripts/*test*.sh",
    "lane": "devnet",
    "reason": "Executable shell test drivers; each script documents its node, chain and environment prerequisites",
    "cadence": "manual",
    "command": "bash {file}"
  },
  {
    "pattern": "scripts/ci/verify-blazegraph-image-contract.sh",
    "lane": "image-contract",
    "reason": "Native image contract verification in the ARM64 CI lane",
    "cadence": "required",
    "command": "bash scripts/ci/verify-blazegraph-image-contract.sh"
  },
  {
    "pattern": "packages/cli/test/fixtures/*.sh",
