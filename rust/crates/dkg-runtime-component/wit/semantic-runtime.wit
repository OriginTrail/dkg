package origintrail:semantic-runtime@0.1.0;

interface capability {
  resource execution-capability;
}

interface investigator {
  use capability.{execution-capability};

  record tool-error {
    code: string,
    message: string,
    retryable: bool,
  }

  record request {
    effect-id: u64,
    prompt: string,
  }

  investigate: async func(
    capability: borrow<execution-capability>,
    request: request,
  ) -> result<string, tool-error>;
}

interface query-catalog {
  use capability.{execution-capability};

  record tool-error {
    code: string,
    message: string,
    retryable: bool,
  }

  record parameter {
    name: string,
    value: string,
  }

  record request {
    effect-id: u64,
    query-id: string,
    parameters: list<parameter>,
  }

  record query-result {
    json: string,
  }

  query: async func(
    capability: borrow<execution-capability>,
    request: request,
  ) -> result<query-result, tool-error>;
}

interface safe-llm {
  use capability.{execution-capability};

  record tool-error {
    code: string,
    message: string,
    retryable: bool,
  }

  record request {
    effect-id: u64,
    prompt: string,
  }

  run: async func(
    capability: borrow<execution-capability>,
    request: request,
  ) -> result<string, tool-error>;
}

interface remote-execute {
  use capability.{execution-capability};

  record tool-error {
    code: string,
    message: string,
    retryable: bool,
  }

  record request {
    effect-id: u64,
    node-id: string,
    program-iri: string,
  }

  record execution-result {
    execution-iri: string,
    execution-ual: option<string>,
  }

  execute: async func(
    capability: borrow<execution-capability>,
    request: request,
  ) -> result<execution-result, tool-error>;
}

interface executor {
  use capability.{execution-capability};

  record diagnostic {
    code: string,
    message: string,
    category: string,
    retryable: bool,
  }

  record source-position {
    line: u64,
    column: u64,
  }

  record source-span {
    start: source-position,
    end: source-position,
  }

  record admission-diagnostic {
    code: string,
    primary: source-span,
    message: string,
    help: option<string>,
  }

  record adapter-version {
    operation: string,
    version: u16,
  }

  record resource-bounds {
    processes: u32,
    host-commands: u32,
    retry-attempts: u32,
    depth: u16,
  }

  record admitted-plan {
    canonical-plan: list<u8>,
    canonical-hash: list<u8>,
    strategy-ref: string,
    scope: string,
    goal: string,
    required-capabilities: list<string>,
    effect-upper-bound: list<string>,
    approval-requirements: list<string>,
    adapter-versions: list<adapter-version>,
    bounds: resource-bounds,
  }

  record logical-agent {
    role: string,
    process-id: list<u8>,
    status: string,
  }

  record execution-receipt {
    canonical-hash: list<u8>,
    strategy-ref: string,
    logical-time: u64,
    state-digest: list<u8>,
    agents: list<logical-agent>,
  }

  record plan-value {
    role: string,
    process-id: list<u8>,
    value: string,
  }

  record completion {
    events: list<plan-value>,
    outputs: list<plan-value>,
  }

  variant step {
    completed(completion),
  }

  resource execution {
    advance: async func() -> result<step, diagnostic>;
    inspect: func() -> result<execution-receipt, diagnostic>;
  }

  abi-version: func() -> u32;
  compile: func(source: string) -> result<admitted-plan, list<admission-diagnostic>>;
  admit: func(plan: list<u8>) -> result<admitted-plan, diagnostic>;
  start: func(
    capability: execution-capability,
    plan: list<u8>,
    logical-time: u64,
  ) -> result<tuple<execution, execution-receipt>, diagnostic>;
}

world semantic-runtime {
  import capability;
  import investigator;
  import query-catalog;
  import safe-llm;
  import remote-execute;
  export executor;
}
