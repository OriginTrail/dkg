{
  "_readme": [
    "Secret-free mirror of DKG Grafana alerting. GENERATED — edit lib/alerts.mjs and lib/notification-template.mjs.",
    "The committed artifact keeps datasource and Slack webhook placeholders. Render a live payload with generate-observability.mjs.",
    "The apply script preserves existing Slack webhook secrets, backs up live state, upserts generated resources, removes the explicitly listed legacy rules, and verifies the result.",
    "Human incident contract: 10 event-specific rules; P1/P2 real-time, sustained P3 grouped daily; no generic ERROR/WARN paging."
  ],
  "evaluationGroups": [
    {
      "name": "dkg-node-telemetry",
      "interval": 60
    },
    {
      "name": "dkg-node-health",
      "interval": 300
    },
    {
      "name": "dkg-capacity-watch",
      "interval": 3600
    }
  ],
  "notificationTemplates": [
    {
      "name": "dkg-readable",
      "template": "{{ define \"dkg.title\" }}{{ end }}\n{{ define \"dkg.body\" -}}\n{{- if .Alerts.Firing -}}\n{{- range .Alerts.Firing }}\n{{ if eq .Labels.priority \"P1\" }}🔴{{ else if eq .Labels.priority \"P2\" }}🟠{{ else if eq .Labels.priority \"P3\" }}🟡{{ else }}🔵{{ end }} *[{{ if eq .Labels.priority \"P1\" }}P1 — CRITICAL{{ else if eq .Labels.priority \"P2\" }}P2 — ACTION{{ else if eq .Labels.priority \"P3\" }}P3 — WATCH{{ else }}TEST{{ end }}] {{ with .Annotations.slack_title }}{{ . }}{{ else }}{{ .Labels.alertname }}{{ end }}*\n{{ with index .Labels \"deployment_environment\" }}*Environment:* {{ . }}\n{{ end }}{{ with .Annotations.what_happened }}*What happened:* {{ . }}\n{{ end }}{{ with .Annotations.affected }}*Affected:* {{ . }}\n{{ end }}{{ with .Annotations.react }}*React:* {{ . }}\n{{ end }}{{ with .Annotations.check_first }}*Check first:* {{ . }}\n{{ end }}{{ with .Annotations.evidence }}*Evidence:* {{ . }}\n{{ end }}{{ if or .Annotations.dashboard_url .Annotations.logs_url .Annotations.runbook_url }}*Links:*{{ with .Annotations.dashboard_url }} <{{ . }}|Open dashboard>{{ end }}{{ with .Annotations.logs_url }} · <{{ . }}|Open logs>{{ end }}{{ with .Annotations.runbook_url }} · <{{ . }}|Runbook>{{ end }}\n{{ end }}\n{{- end -}}\n{{- end -}}\n{{- if .Alerts.Resolved -}}\n{{- range .Alerts.Resolved }}\n✅ *[RECOVERED][{{ with .Labels.priority }}{{ . }}{{ else }}DKG{{ end }}] {{ with .Annotations.slack_title }}{{ . }}{{ else }}{{ .Labels.alertname }}{{ end }}*\nThe alert is no longer firing. The issue lasted {{ .EndsAt.Sub .StartsAt }}. No immediate action is required.\n{{ if or .Annotations.dashboard_url .Annotations.logs_url .Annotations.runbook_url }}*Links:*{{ with .Annotations.dashboard_url }} <{{ . }}|Open dashboard>{{ end }}{{ with .Annotations.logs_url }} · <{{ . }}|Open logs>{{ end }}{{ with .Annotations.runbook_url }} · <{{ . }}|Runbook>{{ end }}\n{{ end }}\n{{- end -}}\n{{- end -}}\n{{- end }}"
    }
  ],
  "contactPoints": [
    {
      "name": "DKG node logs (Slack)",
      "type": "slack",
      "settings": {
        "url": "<SLACK_WEBHOOK_NODE_LOGS>",
        "title": "{{ template \"dkg.title\" . }}",
        "text": "{{ template \"dkg.body\" . }}"
      },
      "disableResolveMessage": false
    },
    {
      "name": "DKG node metrics (Slack)",
      "type": "slack",
      "settings": {
        "url": "<SLACK_WEBHOOK_NODE_METRICS>",
        "title": "{{ template \"dkg.title\" . }}",
        "text": "{{ template \"dkg.body\" . }}"
      },
      "disableResolveMessage": false
    },
    {
      "name": "DKG node traces (Slack)",
      "type": "slack",
      "settings": {
        "url": "<SLACK_WEBHOOK_NODE_TRACES>",
        "title": "{{ template \"dkg.title\" . }}",
        "text": "{{ template \"dkg.body\" . }}"
      },
      "disableResolveMessage": false
    }
  ],
  "policyRoutes": [
    {
      "receiver": "DKG node logs (Slack)",
      "object_matchers": [
        [
          "team",
          "=",
          "dkg"
        ],
        [
          "signal",
          "=",
          "logs"
        ],
        [
          "priority",
          "=~",
          "P1|P2"
        ]
      ],
      "group_by": [
        "alertname",
        "priority",
        "deployment_environment",
        "service_instance_id"
      ],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h",
      "continue": false
    },
    {
      "receiver": "DKG node metrics (Slack)",
      "object_matchers": [
        [
          "team",
          "=",
          "dkg"
        ],
        [
          "signal",
          "=",
          "metrics"
        ],
        [
          "priority",
          "=~",
          "P1|P2"
        ]
      ],
      "group_by": [
        "alertname",
        "priority",
        "deployment_environment",
        "service_instance_id",
        "instance"
      ],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h",
      "continue": false
    },
    {
      "receiver": "DKG node traces (Slack)",
      "object_matchers": [
        [
          "team",
          "=",
          "dkg"
        ],
        [
          "signal",
          "=",
          "traces"
        ],
        [
          "priority",
          "=~",
          "P1|P2"
        ]
      ],
      "group_by": [
        "alertname",
        "priority",
        "deployment_environment",
        "service_instance_id"
      ],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h",
      "continue": false
    },
    {
      "receiver": "DKG node metrics (Slack)",
      "object_matchers": [
        [
          "team",
          "=",
          "dkg"
        ],
        [
          "priority",
          "=",
          "P3"
        ]
      ],
      "group_by": [
        "alertname",
        "priority",
        "deployment_environment"
      ],
      "group_wait": "24h",
      "group_interval": "24h",
      "repeat_interval": "24h",
      "continue": false
    }
  ],
  "rules": [
    {
      "orgID": 1,
      "folderUID": "dkg-observability",
      "ruleGroup": "dkg-node-health",
      "title": "Node stopped reporting",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 60,
            "to": 0
          },
          "datasourceUid": "loki",
          "model": {
            "refId": "A",
            "expr": "(absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"Anacreon\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"Cinna\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"DMaaST\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"Decentralized Science\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"EG - Luigi\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"Helicon\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"Oliwav\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"Rhodia\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"SBB\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"Terminus\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"Trace Labs Node 7\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"cosmo_cluster\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"luna_lander\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"saturn_station\"}[15m]) or absent_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\", service_instance_id=\"umanitek\"}[15m])) and on() (count(sum by (service_instance_id, deployment_environment) (count_over_time({service_name=\"dkg-node\"}[15m]))) > 0)",
            "queryType": "range",
            "intervalMs": 10800000,
            "maxDataPoints": 1,
            "datasource": {
              "type": "loki",
              "uid": "loki"
            }
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "reduce",
            "expression": "A",
            "reducer": "last",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "math",
            "expression": "$B > 0",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "KeepLast",
      "for": "5m",
      "labels": {
        "team": "dkg",
        "signal": "logs",
        "priority": "P2",
        "component": "node",
        "entity_kind": "node",
        "alert_id": "node-silent"
      },
      "annotations": {
        "summary": "Node {{ $labels.service_instance_id }} stopped reporting",
        "slack_title": "Node {{ $labels.service_instance_id }} stopped reporting",
        "what_happened": "No logs or health signals have been received from this node.",
        "affected": "We cannot confirm whether this node is working. Other nodes are still reporting.",
        "react": "Yes — check the node soon.",
        "check_first": "Confirm that the node process and telemetry exporter are running.",
        "evidence": "No signal for 15 minutes from a node in the expected production roster.",
        "dashboard_url": "http://100.81.85.62:3000/d/dkg-node-logs?orgId=1&var-node={{ $labels.service_instance_id }}",
        "logs_url": "http://100.81.85.62:3000/d/dkg-node-logs?orgId=1&var-node={{ $labels.service_instance_id }}",
        "runbook_url": "https://github.com/OriginTrail/dkg/blob/main/tools/observability/RUNBOOK.md"
      }
    },
    {
      "orgID": 1,
      "folderUID": "dkg-observability",
      "ruleGroup": "dkg-node-telemetry",
      "title": "Mainnet fleet stopped reporting",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 60,
            "to": 0
          },
          "datasourceUid": "loki",
          "model": {
            "refId": "A",
            "expr": "count(sum by (service_instance_id) (count_over_time({service_name=\"dkg-node\", deployment_environment=\"mainnet\"}[15m])))",
            "queryType": "range",
            "intervalMs": 900000,
            "maxDataPoints": 1,
            "datasource": {
              "type": "loki",
              "uid": "loki"
            }
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "reduce",
            "expression": "A",
            "reducer": "last",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "math",
            "expression": "$B < 1",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "KeepLast",
      "for": "5m",
      "labels": {
        "team": "dkg",
        "signal": "logs",
        "priority": "P1",
        "component": "telemetry",
        "entity_kind": "fleet",
        "alert_id": "fleet-blackout-mainnet",
        "deployment_environment": "mainnet"
      },
      "annotations": {
        "summary": "MAINNET monitoring has stopped",
        "slack_title": "MAINNET monitoring has stopped",
        "what_happened": "Grafana has not received logs from any DKG mainnet node for 15 minutes.",
        "affected": "The whole mainnet fleet, or the monitoring pipeline.",
        "react": "Yes — check this immediately.",
        "check_first": "Confirm that the telemetry collector and Loki are running, then check fleet reachability.",
        "evidence": "0 mainnet nodes are reporting.",
        "dashboard_url": "http://100.81.85.62:3000/d/dkg-fleet-logs?orgId=1",
        "logs_url": "http://100.81.85.62:3000/d/dkg-fleet-logs?orgId=1",
        "runbook_url": "https://github.com/OriginTrail/dkg/blob/main/tools/observability/RUNBOOK.md"
      }
    },
    {
      "orgID": 1,
      "folderUID": "dkg-observability",
      "ruleGroup": "dkg-node-telemetry",
      "title": "Node storage overloaded",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 60,
            "to": 0
          },
          "datasourceUid": "loki",
          "model": {
            "refId": "A",
            "expr": "sum by (service_instance_id, deployment_environment) (count_over_time({service_name=\"dkg-node\"} |~ `Store scheduler (queue wait timeout|queue full).*blazegraph\\.(query|update)|Blazegraph operation exceeded its [0-9]+ms deadline` [10m]))",
            "queryType": "range",
            "intervalMs": 600000,
            "maxDataPoints": 1,
            "datasource": {
              "type": "loki",
              "uid": "loki"
            }
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "reduce",
            "expression": "A",
            "reducer": "last",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "math",
            "expression": "$B > 20",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "KeepLast",
      "for": "10m",
      "labels": {
        "team": "dkg",
        "signal": "logs",
        "priority": "P2",
        "component": "storage",
        "entity_kind": "node",
        "alert_id": "storage-overloaded"
      },
      "annotations": {
        "summary": "Node {{ $labels.service_instance_id }} storage is overloaded",
        "slack_title": "Node {{ $labels.service_instance_id }} storage is overloaded",
        "what_happened": "Database requests are waiting too long and timing out.",
        "affected": "Random Sampling work on this node is being delayed.",
        "react": "Yes — investigate this soon.",
        "check_first": "Check Blazegraph health and the storage scheduler queue.",
        "evidence": "{{ printf \"%.0f\" $values.B }} storage timeouts in 10 minutes; alert threshold is 20.",
        "dashboard_url": "http://100.81.85.62:3000/d/dkg-node-logs?orgId=1&var-node={{ $labels.service_instance_id }}",
        "logs_url": "http://100.81.85.62:3000/d/dkg-node-logs?orgId=1&var-node={{ $labels.service_instance_id }}&var-level=ERROR&var-search=Store%20scheduler%7CBlazegraph%20operation",
        "runbook_url": "https://github.com/OriginTrail/dkg/blob/main/tools/observability/RUNBOOK.md"
      }
    },
    {
      "orgID": 1,
      "folderUID": "dkg-observability",
      "ruleGroup": "dkg-capacity-watch",
      "title": "RPC usage unusually high",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 60,
            "to": 0
          },
          "datasourceUid": "loki",
          "model": {
            "refId": "A",
            "expr": "(sum by (service_instance_id, deployment_environment) (sum_over_time({service_name=\"dkg-node\"} |= `rpc_usage` | logfmt | method != `` | unwrap count [1h]))) and on (service_instance_id, deployment_environment) ((sum by (service_instance_id, deployment_environment) (sum_over_time({service_name=\"dkg-node\"} |= `rpc_usage` | logfmt | method != `` | unwrap count [15m]))) * 4 > 7200)",
            "queryType": "range",
            "intervalMs": 3600000,
            "maxDataPoints": 1,
            "datasource": {
              "type": "loki",
              "uid": "loki"
            }
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "reduce",
            "expression": "A",
            "reducer": "last",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "math",
            "expression": "$B > 8000",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "KeepLast",
      "for": "30m",
      "labels": {
        "team": "dkg",
        "signal": "metrics",
        "priority": "P3",
        "component": "chain-rpc",
        "entity_kind": "node",
        "alert_id": "rpc-usage-watch"
      },
      "annotations": {
        "summary": "RPC usage is unusually high on {{ $labels.service_instance_id }}",
        "slack_title": "RPC usage is unusually high on {{ $labels.service_instance_id }}",
        "what_happened": "This node has used more blockchain RPC requests than normal for a sustained period.",
        "affected": "No service failure is confirmed, but provider costs may increase.",
        "react": "No immediate action is required; review it in the daily summary.",
        "check_first": "Check which blockchain operation is generating the requests.",
        "evidence": "{{ printf \"%.0f\" $values.B }} requests in the last hour; watch level is 8,000.",
        "dashboard_url": "http://100.81.85.62:3000/d/dkg-node-logs?orgId=1&var-node={{ $labels.service_instance_id }}",
        "logs_url": "http://100.81.85.62:3000/d/dkg-node-logs?orgId=1&var-node={{ $labels.service_instance_id }}&var-search=rpc_usage",
        "runbook_url": "https://github.com/OriginTrail/dkg/blob/main/tools/observability/RUNBOOK.md"
      }
    },
    {
      "orgID": 1,
      "folderUID": "dkg-observability",
      "ruleGroup": "dkg-node-telemetry",
      "title": "Telemetry collector cannot export logs",
      "condition": "C",
