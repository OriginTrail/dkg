{
  "_readme": [
    "Secret-free mirror of the alerting on the DKG observability Grafana. GENERATED by generate-observability.mjs (from ALERT_SPECS) - edit that script, not this file.",
    "The committed artifact keeps <VM_DATASOURCE_UID> as a placeholder (instance-specific UID). Render an importable payload for your instance with:",
    "  node generate-observability.mjs /tmp/render --vm-uid <your-vm-uid> [--loki-uid <your-loki-uid>]",
    "Import with an admin session and header X-Disable-Provenance: true (keeps everything UI-editable):",
    "  1. For each entry in contactPoints: POST /api/v1/provisioning/contact-points  (fill url from your password manager first)",
    "  2. GET /api/v1/provisioning/policies, APPEND policyRoutes to .routes, PUT the tree back (a PUT replaces the WHOLE tree - never PUT without GET+append)",
    "  3. For each entry in rules: POST /api/v1/provisioning/alert-rules",
    "Verified: this exact payload (rendered with the production UIDs) was imported into the production Grafana 11.4.0 on 2026-07-02; all 10 rules evaluate health=ok on the scheduler and route to the three Slack channels."
  ],
  "contactPoints": [
    {
      "name": "DKG node logs (Slack)",
      "type": "slack",
      "settings": {
        "url": "<SLACK_WEBHOOK_NODE_LOGS>"
      },
      "disableResolveMessage": false
    },
    {
      "name": "DKG node metrics (Slack)",
      "type": "slack",
      "settings": {
        "url": "<SLACK_WEBHOOK_NODE_METRICS>"
      },
      "disableResolveMessage": false
    },
    {
      "name": "DKG node traces (Slack)",
      "type": "slack",
      "settings": {
        "url": "<SLACK_WEBHOOK_NODE_TRACES>"
      },
      "disableResolveMessage": false
    }
  ],
  "policyRoutes": [
    {
      "receiver": "DKG node logs (Slack)",
      "object_matchers": [
        [
          "team",
          "=",
          "dkg"
        ],
        [
          "signal",
          "=",
          "logs"
        ]
      ],
      "group_by": [
        "alertname",
        "service_instance_id"
      ],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h",
      "continue": false
    },
    {
      "receiver": "DKG node metrics (Slack)",
      "object_matchers": [
        [
          "team",
          "=",
          "dkg"
        ],
        [
          "signal",
          "=",
          "metrics"
        ]
      ],
      "group_by": [
        "alertname",
        "service_instance_id",
        "instance"
      ],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h",
      "continue": false
    },
    {
      "receiver": "DKG node traces (Slack)",
      "object_matchers": [
        [
          "team",
          "=",
          "dkg"
        ],
        [
          "signal",
          "=",
          "traces"
        ]
      ],
      "group_by": [
        "alertname"
      ],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h",
      "continue": false
    }
  ],
  "rules": [
    {
      "orgID": 1,
      "folderUID": "dkg-observability",
      "ruleGroup": "dkg-node-telemetry",
      "title": "Node silent — seen in last 3h, quiet 15m (per node)",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "loki",
          "model": {
            "refId": "A",
            "expr": "count by (service_instance_id) (count_over_time({service_name=\"dkg-node\"}[3h] offset 15m)) unless count by (service_instance_id) (count_over_time({service_name=\"dkg-node\"}[15m]))",
            "queryType": "range",
            "intervalMs": 60000,
            "maxDataPoints": 50,
            "datasource": {
              "type": "loki",
              "uid": "loki"
            }
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "reduce",
            "expression": "A",
            "reducer": "last",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "math",
            "expression": "$B > 0",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "5m",
      "labels": {
        "team": "dkg",
        "signal": "logs"
      },
      "annotations": {
        "summary": "Node {{ $labels.service_instance_id }} was shipping logs (seen in the 3h window) but has been silent for 15m. Fires per node — unaffected by other nodes joining or leaving."
      }
    },
    {
      "orgID": 1,
      "folderUID": "dkg-observability",
      "ruleGroup": "dkg-node-telemetry",
      "title": "Fleet blackout — NO node logs reaching Loki",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "loki",
          "model": {
            "refId": "A",
            "expr": "count(sum by (service_instance_id) (count_over_time({service_name=\"dkg-node\"}[15m])))",
            "queryType": "range",
            "intervalMs": 60000,
            "maxDataPoints": 50,
            "datasource": {
              "type": "loki",
              "uid": "loki"
            }
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "reduce",
            "expression": "A",
            "reducer": "last",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "math",
            "expression": "$B < 1",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Error",
      "for": "5m",
      "labels": {
        "team": "dkg",
        "signal": "logs"
      },
      "annotations": {
        "summary": "Zero nodes have shipped any logs in 15m — the whole fleet or the ingest pipeline (collector/Loki) is down."
      }
    },
