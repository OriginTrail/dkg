          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, protocol_id) (rate({__name__=~\"dkg_protocol_router_send_duration(_milliseconds)?_bucket\", instance=~\"${node:regex}\"}[$__rate_interval])))",
          "legendFormat": "p95 {{protocol_id}}"
        }
      ]
    },
    {
      "id": 17,
      "title": "Pipeline health (collector — live now)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "type": "row",
      "collapsed": false
    },
    {
      "id": 18,
      "title": "Collector log records/s: accepted vs exported",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 47
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_accepted_log_records[$__rate_interval]))",
          "legendFormat": "accepted (in)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "B",
          "expr": "sum(rate(otelcol_exporter_sent_log_records[$__rate_interval]))",
          "legendFormat": "sent (out)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "C",
          "expr": "sum(rate(otelcol_exporter_send_failed_log_records[$__rate_interval]))",
          "legendFormat": "send FAILED"
        }
      ]
    },
    {
      "id": 19,
      "title": "Collector exporter queue",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 47
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "sum(otelcol_exporter_queue_size)",
          "legendFormat": "queue size"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "B",
          "expr": "sum(otelcol_exporter_queue_capacity)",
          "legendFormat": "capacity"
        }
      ]
    },
    {
      "id": 20,
      "title": "Collector CPU / memory",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 47
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
