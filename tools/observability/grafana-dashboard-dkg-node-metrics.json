        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "B",
          "expr": "sum(otelcol_process_memory_rss)",
          "legendFormat": "RSS bytes"
        }
      ]
    }
  ]
}
