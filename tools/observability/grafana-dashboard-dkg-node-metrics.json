{
  "uid": "dkg-node-metrics",
  "title": "DKG Nodes — Metrics",
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "dkg",
    "metrics"
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "dkg"
      ],
      "asDropdown": true,
      "title": "DKG dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "description": "OTel metrics from dkg-node (meter @origintrail-official/dkg). Node label profile: instance (= service.instance.id under the canonical OTLP mapping). If the collector emits a different node label (e.g. resource_to_telemetry_conversion -> service_instance_id), regenerate with --prom-node-label.",
  "templating": {
    "list": [
      {
        "name": "vm",
        "type": "datasource",
        "query": "prometheus",
        "label": "Metrics DS",
        "hide": 2,
        "current": {}
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${vm}"
        },
        "query": "label_values({__name__=~\"dkg_.+\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "allowCustomValue": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "**Requires node metric export.** These panels read OTel metrics from dkg-node; a node ships them when it resolves a metrics endpoint (env `OTEL_EXPORTER_OTLP_ENDPOINT=http://<collector>:4318` or config `telemetry.metrics.endpoint`) and the collector routes metrics → VictoriaMetrics. Empty panels mean no node currently exports metrics — see RUNBOOK.md for rollout state and enablement steps. The **Pipeline health** row reads the collector's self-monitoring and works independently of node export."
      },
      "transparent": true
    },
    {
      "id": 2,
      "title": "Publishing",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "type": "row",
      "collapsed": false
    },
    {
      "id": 3,
      "title": "Publish rate by outcome",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(dkg_publish_total{instance=~\"${node:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Publish duration p50/p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"dkg_publish_duration(_milliseconds)?_bucket\", instance=~\"${node:regex}\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate({__name__=~\"dkg_publish_duration(_milliseconds)?_bucket\", instance=~\"${node:regex}\"}[$__rate_interval])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 5,
      "title": "ACK quorum outcomes",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(dkg_ack_quorum_total{instance=~\"${node:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "ACK peer results (publisher side)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "sum by (result) (rate(dkg_ack_peer_total{instance=~\"${node:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "ACK declines by code + handler outcomes",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "sum by (decline_code) (rate(dkg_ack_peer_total{result=\"decline\", instance=~\"${node:regex}\"}[$__rate_interval]))",
          "legendFormat": "sent-to-us: {{decline_code}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "B",
          "expr": "sum by (outcome) (rate(dkg_ack_handler_total{instance=~\"${node:regex}\"}[$__rate_interval]))",
          "legendFormat": "handler: {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Chain / RPC",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "type": "row",
      "collapsed": false
    },
    {
      "id": 9,
      "title": "Raw RPC requests by method (billing unit — post-#1409 node builds)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "sum by (rpc_method) (rate(dkg_chain_rpc_requests_total{instance=~\"${node:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{rpc_method}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Raw RPC requests per node (post-#1409 node builds)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "sum by (instance) (rate(dkg_chain_rpc_requests_total{instance=~\"${node:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Logical chain ops by method/outcome",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "sum by (rpc_method, outcome) (rate(dkg_chain_rpc_total{instance=~\"${node:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{rpc_method}} {{outcome}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Chain RPC p95 latency by method",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, rpc_method) (rate({__name__=~\"dkg_chain_rpc_duration(_milliseconds)?_bucket\", instance=~\"${node:regex}\"}[$__rate_interval])))",
          "legendFormat": "{{rpc_method}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "RPC endpoint failover exhaustion",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "sum by (instance) (rate(dkg_chain_rpc_failover_total{reason=\"exhausted\", instance=~\"${node:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "P2P / Sync",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "type": "row",
      "collapsed": false
    },
    {
      "id": 15,
      "title": "Sync requests & responses by outcome",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(dkg_sync_request_total{instance=~\"${node:regex}\"}[$__rate_interval]))",
          "legendFormat": "request: {{outcome}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "B",
          "expr": "sum by (outcome) (rate(dkg_sync_response_total{instance=~\"${node:regex}\"}[$__rate_interval]))",
          "legendFormat": "response: {{outcome}}"
        }
      ]
    },
    {
      "id": 16,
      "title": "Protocol send rate + p95 by protocol",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${vm}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${vm}"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(dkg_protocol_router_send_total{instance=~\"${node:regex}\"}[$__rate_interval]))",
          "legendFormat": "send: {{outcome}}"
        },
