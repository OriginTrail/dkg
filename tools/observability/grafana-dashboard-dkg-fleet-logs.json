{
  "uid": "dkg-fleet-logs",
  "title": "DKG Fleet — Logs Overview",
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "dkg",
    "logs"
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "dkg"
      ],
      "asDropdown": true,
      "title": "DKG dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "current": {}
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "query": "label_values(deployment_environment)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Nodes reporting (last 10m)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "instant": true,
          "queryType": "instant",
          "expr": "count(count by (service_instance_id) (count_over_time({service_name=\"dkg-node\", deployment_environment=~\"${env:regex}\"} [10m])))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Per-node log heartbeat (last 2m; missing node = absent)",
      "gridPos": {
        "h": 9,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "type": "bargauge",
      "description": "Every expected node should appear here. A missing node has not sent any logs in the last two minutes.",
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (service_instance_id) (count_over_time({service_name=\"dkg-node\", deployment_environment=~\"${env:regex}\"} [2m]))",
          "legendFormat": "{{service_instance_id}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errors per node",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (service_instance_id) (count_over_time({service_name=\"dkg-node\", deployment_environment=~\"${env:regex}\"} | severity_text=`ERROR` [$__auto]))",
          "legendFormat": "{{service_instance_id}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Recent errors (all nodes)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "type": "logs",
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "{service_name=\"dkg-node\", deployment_environment=~\"${env:regex}\"} | severity_text=`ERROR`"
        }
      ]
    },
    {
      "id": 5,
      "title": "RPC requests per node",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (service_instance_id) (sum_over_time({service_name=\"dkg-node\", deployment_environment=~\"${env:regex}\"} |= `rpc_usage` | logfmt | method != `` | unwrap count [$__auto]))",
          "legendFormat": "{{service_instance_id}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "RPC requests by method (fleet)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (method) (sum_over_time({service_name=\"dkg-node\", deployment_environment=~\"${env:regex}\"} |= `rpc_usage` | logfmt | method != `` | unwrap count [$__auto]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Total RPC requests (selected range)",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum(sum_over_time({service_name=\"dkg-node\", deployment_environment=~\"${env:regex}\"} |= `rpc_usage` | logfmt | method != `` | unwrap count [$__auto]))"
        }
      ]
    },
    {
      "id": 8,
      "title": "Top nodes by RPC requests (selected range) — credit burners",
      "gridPos": {
        "h": 7,
        "w": 18,
        "x": 6,
        "y": 36
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "type": "bargauge",
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        }
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "sum"
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Total",
                "desc": true
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "legendFormat": "{{service_instance_id}}",
          "expr": "sum by (service_instance_id) (sum_over_time({service_name=\"dkg-node\", deployment_environment=~\"${env:regex}\"} |= `rpc_usage` | logfmt | method != `` | unwrap count [$__auto]))"
        }
      ]
    }
  ]
}
