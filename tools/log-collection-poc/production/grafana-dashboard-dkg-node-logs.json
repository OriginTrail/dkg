{
  "uid": "dkg-node-logs",
  "title": "DKG Node — Logs",
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "dkg",
    "logs"
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "dkg"
      ],
      "asDropdown": true,
      "title": "DKG dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "current": {}
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "query": "label_values(service_instance_id)",
        "refresh": 2,
        "current": {}
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "DEBUG,INFO,WARN,ERROR",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "Filter (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "type": "logs",
      "title": "Logs — $node",
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "{service_instance_id=\"$node\"} | severity_text=~`${level:regex}` |~ `(?i)$search`"
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "type": "timeseries",
      "title": "Log volume by level — $node",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (severity_text) (count_over_time({service_instance_id=\"$node\"} | severity_text=~`${level:regex}` |~ `(?i)$search` [$__auto]))",
          "legendFormat": "{{severity_text}}"
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "type": "timeseries",
      "title": "RPC requests by method — $node",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (method) (sum_over_time({service_instance_id=\"$node\"} |= `rpc_usage` | logfmt | method != `` | unwrap count [$__auto]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "type": "stat",
      "title": "RPC requests — $node (selected range)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum(sum_over_time({service_instance_id=\"$node\"} |= `rpc_usage` | logfmt | method != `` | unwrap count [$__auto]))"
        }
      ]
    }
  ]
}
