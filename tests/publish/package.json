{
  "name": "dkg-v10-publish-tests",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "DKG v10 publish/query lifecycle tests \u2014 per-node publish/query/local-get verification with opt-in remote-get and Grafana import",
  "scripts": {
    "test": "mocha src/v10-publish-test.spec.js --timeout 7200000 --exit",
    "test:harness": "mocha test/v10-publish-harness.test.js --timeout 5000 --exit",
    "test:base:mainnet": "node scripts/run_node_suites.js base-mainnet",
    "test:base:sbb:mainnet": "node scripts/run_node_suites.js base-mainnet SBB",
    "test:base:dmaast:mainnet": "node scripts/run_node_suites.js base-mainnet DMaaST",
    "test:gnosis:mainnet": "node scripts/run_node_suites.js gnosis-mainnet",
    "test:gnosis:terminus:mainnet": "node scripts/run_node_suites.js gnosis-mainnet Terminus",
    "test:gnosis:rhodia:mainnet": "node scripts/run_node_suites.js gnosis-mainnet Rhodia",
    "test:base:testnet": "node scripts/run_node_suites.js base-testnet",
    "test:base:testnode1:testnet": "node scripts/run_node_suites.js base-testnet TestNode1",
    "test:base:testnode2:testnet": "node scripts/run_node_suites.js base-testnet TestNode2",
    "test:base:testnode3:testnet": "node scripts/run_node_suites.js base-testnet TestNode3",
    "test:base:testnode4:testnet": "node scripts/run_node_suites.js base-testnet TestNode4",
    "insert-summary": "node scripts/insert_summary_to_db.js",
    "insert-errors": "node scripts/insert_errors_to_db.js",
    "print-errors": "node scripts/print_aggregated_errors.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mocha": "^11.1.0",
    "mochawesome": "^7.1.3",
    "mysql2": "^3.11.0",
    "pg": "^8.13.1",
    "undici": "^7.3.0"
  }
}
