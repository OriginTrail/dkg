{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkg.origintrail.io/schemas/rpc-usage-minutes-v1.json",
  "title": "Redacted minutely JSON-RPC usage evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "samples"],
  "properties": {
    "schema": { "const": "dkg-rpc-usage-minutes-v1" },
    "scope": { "const": "certified-cohort" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1440,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["windowStartedAt", "windowEndedAt", "total", "byMethod"],
        "properties": {
          "windowStartedAt": { "type": "string", "format": "date-time" },
          "windowEndedAt": { "type": "string", "format": "date-time" },
          "total": { "type": "integer", "minimum": 0 },
          "byMethod": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,127}$" },
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
