{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkg.origintrail.io/schemas/rfc64-remote-canary-config-v1.json",
  "title": "RFC-64 remote canary certification configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "expectedCommit",
    "nodes",
    "contextGraphs",
    "authorizationChecks",
    "rpcUsage"
  ],
  "properties": {
    "schema": { "const": "dkg-rfc64-remote-canary-config-v1" },
    "expectedCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "baseUrl", "auth"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "role": { "enum": ["source", "receiver", "observer"] },
          "baseUrl": { "type": "string", "format": "uri" },
          "allowTailscaleHttp": { "type": "boolean" },
          "auth": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": { "kind": { "const": "none" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "secretFile"],
                "properties": {
                  "kind": { "const": "bearer-file" },
                  "secretFile": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    },
    "contextGraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expectedMode", "sourceNodeId", "receiverNodeId"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 512 },
          "expectedMode": { "const": "catalog" },
          "sourceNodeId": { "type": "string" },
          "receiverNodeId": { "type": "string" },
          "vmAskSparql": { "type": "string", "minLength": 1, "maxLength": 32768 }
        }
      }
    },
    "lifecycle": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["receiverNodeId", "stop", "start"],
          "properties": {
            "receiverNodeId": { "type": "string" },
            "stop": { "$ref": "#/$defs/command" },
            "start": { "$ref": "#/$defs/command" },
            "commandTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
            "stopTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
            "readyTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 }
          }
        }
      ]
    },
    "authorizationChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unauthorized", "revoked"],
      "properties": {
        "unauthorized": { "$ref": "#/$defs/authorizationCheck" },
        "revoked": { "$ref": "#/$defs/authorizationCheck" }
      }
    },
    "rpcUsage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "required" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "evidence-file" },
            "path": { "type": "string", "minLength": 1 },
            "minimumSamples": { "type": "integer", "minimum": 1, "maximum": 1440 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command"],
          "properties": {
            "kind": { "const": "command" },
            "command": { "$ref": "#/$defs/command" },
            "minimumSamples": { "type": "integer", "minimum": 1, "maximum": 1440 },
            "commandTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 }
          }
        }
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "pollIntervalMs": { "type": "integer", "minimum": 250, "maximum": 30000 },
        "propagationTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "catchupTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "parityTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "authorizationCheck": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reasonCode"],
          "properties": {
            "kind": { "const": "not-exposed" },
            "reasonCode": {
              "enum": ["catalog-protocol-api-not-exposed", "revocation-api-not-exposed"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "nodeId",
            "method",
            "path",
            "authentication",
            "expectedStatuses"
          ],
          "properties": {
            "kind": { "const": "http" },
            "nodeId": { "type": "string" },
            "method": { "enum": ["GET", "POST"] },
            "path": { "type": "string", "pattern": "^/api/" },
            "authentication": { "enum": ["none", "node"] },
            "body": { "type": "object" },
            "expectedStatuses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": [401, 403, 404] }
            },
            "bodyCodePointer": { "type": "string", "pattern": "^/" },
            "expectedCodes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        }
      ]
    }
  }
}
