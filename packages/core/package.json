{
  "name": "@origintrail-official/dkg-core",
  "version": "10.0.15",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./project-ontology": {
      "types": "./dist/project-ontology.d.ts",
      "import": "./dist/project-ontology.js",
      "default": "./dist/project-ontology.js"
    },
    "./bounded-response-body": {
      "types": "./dist/bounded-response-body.d.ts",
      "import": "./dist/bounded-response-body.js",
      "default": "./dist/bounded-response-body.js"
    },
    "./query-catalog-parameters": {
      "types": "./dist/query-catalog-parameters.d.ts",
      "import": "./dist/query-catalog-parameters.js",
      "default": "./dist/query-catalog-parameters.js"
    },
    "./query-catalog": {
      "types": "./dist/query-catalog.d.ts",
      "import": "./dist/query-catalog.js",
      "default": "./dist/query-catalog.js"
    },
    "./query-result": {
      "types": "./dist/query-result.d.ts",
      "import": "./dist/query-result.js",
      "default": "./dist/query-result.js"
    },
    "./sparql-safe": {
      "types": "./dist/sparql-safe.d.ts",
      "import": "./dist/sparql-safe.js",
      "default": "./dist/sparql-safe.js"
    },
    "./sparql-lexical-scanner": {
      "types": "./dist/sparql-lexical-scanner.d.ts",
      "import": "./dist/sparql-lexical-scanner.js",
      "default": "./dist/sparql-lexical-scanner.js"
    },
    "./sparql-cursors": {
      "types": "./dist/sparql-cursors.d.ts",
      "import": "./dist/sparql-cursors.js",
      "default": "./dist/sparql-cursors.js"
    },
    "./closed-data-snapshot": {
      "types": "./dist/sync-wire-objects.d.ts",
      "import": "./dist/sync-wire-objects.js",
      "default": "./dist/sync-wire-objects.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && pnpm run test:types",
    "test:types": "tsc --project tsconfig.type-tests.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@origintrail-official/dkg-rdf-utils": "workspace:*",
    "@libp2p/autonat": "^3.0.20",
    "@libp2p/bootstrap": "^12.0.22",
    "@libp2p/circuit-relay-v2": "^4.2.5",
    "@libp2p/crypto": "^5.1.18",
    "@libp2p/dcutr": "^3.0.20",
    "@libp2p/gossipsub": "^15.0.23",
    "@libp2p/identify": "^4.1.6",
    "@libp2p/interface": "^3.2.2",
    "@libp2p/kad-dht": "^16.2.7",
    "@libp2p/mdns": "^12.0.22",
    "@libp2p/noise": "^1.0.1",
    "@libp2p/peer-id": "^6.0.9",
    "@libp2p/ping": "^3.1.5",
    "@libp2p/tcp": "^11.0.20",
    "@libp2p/websockets": "^10.1.13",
    "@libp2p/yamux": "^8.0.1",
    "@multiformats/multiaddr": "^13.0.3",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "@opentelemetry/api": "^1.9.1",
    "js-yaml": "^4.1.1",
    "libp2p": "^3.3.1",
    "protobufjs": "^8.3.0",
    "rdf-canonize": "^5.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@vitest/coverage-v8": "^4.0.18",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OriginTrail/dkg.git",
    "directory": "packages/core"
  }
}
