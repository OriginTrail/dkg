{
  "name": "@origintrail-official/dkg-rdf-utils",
  "version": "10.0.16",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sparql": {
      "types": "./dist/sparql.d.ts",
      "import": "./dist/sparql.js",
      "default": "./dist/sparql.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node ../../scripts/ci/check-coverage.mjs rdf-utils",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OriginTrail/dkg.git",
    "directory": "packages/rdf-utils"
  }
}
